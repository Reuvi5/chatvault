# ChatVault configuration.
#
# Local development needs NONE of this: `npm run dev` uses a file-backed
# metadata store and two local directories as stand-ins for the two storage
# providers. Copy this file to `.env.local` only when you want to change
# something, and fill it in properly before deploying — the server refuses to
# start in production with development defaults.

# ----------------------------------------------------------------- basics ---
# Public origin, used in links and to decide whether cookies are Secure.
APP_URL=http://localhost:3000

# Where the development file store and local object directories live.
CHATVAULT_DATA_DIR=.data

# Signs session cookies and upload tickets and encrypts stored TOTP secrets.
# REQUIRED in production, at least 32 characters:  openssl rand -base64 32
# SERVER_SECRET=

# ------------------------------------------------------------- metadata DB ---
# Unset: the development file store. Set: Postgres (required in production).
# Point this at an UNPRIVILEGED role, or row-level security will not apply.
# DATABASE_URL=postgres://chatvault_app:password@localhost:5432/chatvault
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/chatvault
# DATABASE_APP_ROLE=chatvault_app
# DATABASE_POOL_MAX=10

# ------------------------------------------------------- object storage -----
# Primary copy. In production this must be "s3" (Cloudflare R2 in the plan).
PRIMARY_DRIVER=local
PRIMARY_LABEL=primary
# PRIMARY_DIRECTORY=.data/objects-primary
# PRIMARY_BUCKET=chatvault-primary
# PRIMARY_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PRIMARY_REGION=auto
# PRIMARY_ACCESS_KEY_ID=
# PRIMARY_SECRET_ACCESS_KEY=
# PRIMARY_PART_SIZE_BYTES=8388608

# Second, independent copy. In production this must be "s3" with its own
# credentials (Backblaze B2 in the plan). "none" disables it, which also means
# nothing can ever be reported as Verified.
SECONDARY_DRIVER=local
SECONDARY_LABEL=secondary
# SECONDARY_DIRECTORY=.data/objects-secondary
# SECONDARY_BUCKET=chatvault-backup
# SECONDARY_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# SECONDARY_REGION=us-west-004
# SECONDARY_ACCESS_KEY_ID=
# SECONDARY_SECRET_ACCESS_KEY=
# SECONDARY_PART_SIZE_BYTES=8388608

# --------------------------------------------------------------- pricing ----
# The agreed price. A GB is 1,000,000,000 bytes.
PRICE_USD_PER_GB_MONTH=0.05

# Both of these are decisions the plan left open, and both default to off.
# Do not turn them on without approval (see docs/DECISIONS.md).
BILLING_MINIMUM_CENTS=0
FREE_ALLOWANCE_GB=0

# Per-account storage ceiling, as a safety rail rather than a product promise.
ACCOUNT_QUOTA_GB=2000

# How long a deleted conversation stays restorable before it is purged.
TRASH_RETENTION_DAYS=30

# --------------------------------------------------------------- billing ----
# Without these, billing routes answer "not configured" and nothing is charged.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_METER_EVENT_NAME=chatvault_gb_month

# ------------------------------------------------------------------ misc ----
# console: print email verification links to the server log (development).
# none: do not generate them at all.
EMAIL_DRIVER=console

# Requests per minute per client.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=600
RATE_LIMIT_READ_PER_MIN=1200

# Server-side login password hashing (not the vault passphrase).
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_PARALLELISM=1

# How often the worker runs a pass.
WORKER_INTERVAL_MS=60000

# Extra logging. Never logs plaintext, keys or tickets.
# CHATVAULT_DEBUG=1

# Test switch for the disaster drill: makes the primary provider unreachable.
# Refused in production.
# SIMULATE_PRIMARY_DOWN=1
